<div class="space-y-6" id="org-event-config-view">
  <.breadcrumbs crumbs={[
    {"Accueil", "/"},
    {"Configurations client", "/org-events"},
    {"Édition", ""}
  ]} />

  <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 animate-fade-in-up">
    <div class="flex items-center gap-4">
      <div class="size-12 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center shadow-sm shrink-0">
        <.icon name="hero-cog-6-tooth" class="size-6 text-white" />
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          Configurer l'événement organisationnel
        </h1>
        <p class="text-sm text-slate-500 mt-0.5">
          Personnalisez et surchargez les paramètres spécifiques pour cette organisation cliente
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 animate-fade-in-up delay-1">
    <div class="p-6">
      <.form
        for={@form}
        id="org-event-config-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-6"
      >
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
          
          <div class="lg:col-span-3 space-y-4">
            <div>
              <.input
                field={@form[:organization_id]}
                type="select"
                label="Organisation cliente rattachée"
                prompt="Sélectionner une organisation"
                options={@organizations}
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
              />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <.input
                  field={@form[:code]}
                  type="text"
                  label="Code unique"
                  required
                  list="code-list"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
                <datalist id="code-list">
                  <option :for={code <- @codes} value={code} />
                </datalist>
              </div>

              <div>
                <.input
                  field={@form[:name]}
                  type="text"
                  label="Nom fonctionnel"
                  list="name-list"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
                <datalist id="name-list">
                  <option :for={name <- @names} value={name} />
                </datalist>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="md:col-span-1">
                <.input
                  field={@form[:level]}
                  type="number"
                  label="Niveau de gravité"
                  min="1"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
              </div>

              <div class="md:col-span-2">
                <.input
                  field={@form[:category]}
                  type="select"
                  label="Catégorie structurelle"
                  prompt="Sélectionner une catégorie"
                  options={[
                    {"Physique", "physical"},
                    {"Système", "system"},
                    {"Dérivé", "derived"}
                  ]}
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <.input
                  field={@form[:class]}
                  type="text"
                  label="Classe sémantique"
                  list="class-list"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
                <datalist id="class-list">
                  <option :for={class <- @classes} value={class} />
                </datalist>
              </div>

              <div>
                <.input
                  field={@form[:level_group]}
                  type="text"
                  label="Groupe de niveaux"
                  list="level-group-list"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
                />
                <datalist id="level-group-list">
                  <option :for={lg <- @level_groups} value={lg} />
                </datalist>
              </div>
            </div>

            <div>
              <.input
                field={@form[:definition]}
                type="textarea"
                label="Définition / Documentation technique"
                rows="3"
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
              />
            </div>
          </div>

          <div class="lg:col-span-2 space-y-4">
            <div class="bg-slate-50 rounded-xl border border-slate-200 p-5 space-y-4">
              <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider">
                <.icon name="hero-adjustments-horizontal" class="size-4" /> Comportement & Moteur
              </div>

              <.input
                field={@form[:alert_mode]}
                type="select"
                label="Mode de propagation"
                options={[
                  {"Aucun", "none"},
                  {"Alerte directe", "alert"},
                  {"Rapport périodique", "report"},
                  {"Les deux modes", "both"}
                ]}
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-slate-700"
              />

              <div class="pt-2">
                <label class="inline-flex items-center gap-3 cursor-pointer select-none">
                  <.input
                    field={@form[:enabled]}
                    type="checkbox"
                    class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 size-4 cursor-pointer"
                  />
                  <span class="text-sm font-semibold text-slate-700">
                    Activer cet événement pour l'organisation
                  </span>
                </label>
              </div>

              <div class="pt-2">
                <label class="text-xs font-semibold text-slate-600 block mb-1.5">
                  Règle d'occurrence (JSON)
                </label>
                <.input
                  field={@form[:occurrence_rule]}
                  type="textarea"
                  rows="3"
                  placeholder='{"trigger": "on_change"}'
                  class="w-full font-mono text-xs px-3.5 py-2.5 rounded-lg border-2 border-slate-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-slate-700"
                />
              </div>
            </div>

            <div class="bg-blue-50 rounded-xl border border-blue-100 p-5">
              <div class="flex items-center gap-2 mb-3 text-xs font-bold text-blue-600 uppercase tracking-wider">
                <.icon name="hero-information-circle" class="size-4" /> Vue d'ensemble
              </div>
              <div class="space-y-1.5 text-sm text-blue-800">
                <p>
                  <span class="font-medium text-blue-600">Client :</span>
                  <span class="ml-1 bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-xs font-bold font-mono">
                    {@org_map[@selected_org] || "Aucun"}
                  </span>
                </p>
                <p>
                  <span class="font-medium text-blue-600">Identifiant Code :</span>
                  <code class="font-mono text-xs bg-white/60 px-1 rounded">
                    {@form[:code].value || "—"}
                  </code>
                </p>
                <p>
                  <span class="font-medium text-blue-600">Intitulé :</span> {@form[:name].value ||
                    "—"}
                </p>
                <p>
                  <span class="font-medium text-blue-600">Mode actif :</span>
                  <span class="badge text-xs uppercase font-semibold">
                    {@form[:alert_mode].value || "none"}
                  </span>
                </p>
                <p>
                  <span class="font-medium text-blue-600">Statut d'exécution :</span>
                  <span class={"font-bold text-xs #{if @form[:enabled].value == "true" || @form[:enabled].value == true, do: "text-emerald-600", else: "text-slate-400"}"}>
                    {if @form[:enabled].value == "true" || @form[:enabled].value == true,
                      do: "✓ Opérationnel",
                      else: "✕ Suspendu"}
                  </span>
                </p>
              </div>
            </div>

            <div class="bg-red-50 rounded-xl border border-red-100 p-5">
              <div class="flex items-center gap-2 mb-2 text-xs font-bold text-red-600 uppercase tracking-wider">
                <.icon name="hero-exclamation-triangle" class="size-4" /> Zone de danger
              </div>
              <p class="text-xs text-red-500 mb-4">
                La suppression de cette surcharge supprimera définitivement les configurations d'alertes associées à cette entité cliente.
              </p>
              <button
                type="button"
                phx-click="delete"
                data-confirm="Êtes-vous certain de vouloir détruire définitivement cette configuration ?"
                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold text-red-700 hover:text-white bg-white hover:bg-red-600 border border-red-200 hover:border-red-600 rounded-lg shadow-sm transition-all duration-150"
              >
                <.icon name="hero-trash" class="size-3.5" /> Supprimer la surcharge client
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
          <button
            type="submit"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-all text-sm shadow-sm"
          >
            <.icon name="hero-check" class="size-4" /> Enregistrer les modifications
          </button>
          <.link
            navigate="/org-events"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-all"
          >
            Annuler
          </.link>
        </div>
      </.form>
    </div>
  </div>
</div>
