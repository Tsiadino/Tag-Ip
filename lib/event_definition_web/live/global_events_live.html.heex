<%!-- Page header card --%>
<div class="space-y-6">
  <.breadcrumbs crumbs={[{"Accueil", "/"}, {"Catalogue global", "/global-events"}]} />

  <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 animate-fade-in-up">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-4">
        <div class="size-12 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center shadow-sm shrink-0">
          <.icon name="hero-book-open" class="size-6 text-white" />
        </div>
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
            Catalogue Global des Événements
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Définitions système — <strong class="text-slate-800">{length(@events)}</strong>
            au total
          </p>
        </div>
      </div>
      <.link
        navigate="/global-events/new"
        class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 shrink-0"
      >
        <.icon name="hero-plus" class="size-4" /> Nouvelle Définition
      </.link>
    </div>
  </div>

  <% physical_count = Enum.count(@events, &(&1.category == "physical")) %>
  <% system_count = Enum.count(@events, &(&1.category == "system")) %>
  <% derived_count = Enum.count(@events, &(&1.category == "derived")) %>

  <%!-- Filter pills with icon indicators --%>
  <div class="flex flex-wrap gap-2 animate-fade-in-up delay-1">
    <button
      phx-click="filter"
      phx-value-filter="all"
      class={[
        "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 border",
        @filter == "all" && "bg-blue-600 text-white border-blue-600 shadow-sm",
        @filter != "all" &&
          "bg-white text-slate-600 border-slate-300 hover:border-blue-400 hover:text-blue-600 hover:shadow-sm"
      ]}
    >
      <.icon name="hero-list-bullet" class="size-3.5" /> Toutes
      <span class="opacity-70">({length(@events)})</span>
    </button>
    <button
      phx-click="filter"
      phx-value-filter="physical"
      class={[
        "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 border",
        @filter == "physical" && "bg-blue-600 text-white border-blue-600 shadow-sm",
        @filter != "physical" &&
          "bg-white text-slate-600 border-slate-300 hover:border-blue-400 hover:text-blue-600 hover:shadow-sm"
      ]}
    >
      <.icon name="hero-cpu-chip" class="size-3.5" /> Physiques
      <span class="opacity-70">({physical_count})</span>
    </button>
    <button
      phx-click="filter"
      phx-value-filter="system"
      class={[
        "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 border",
        @filter == "system" && "bg-blue-600 text-white border-blue-600 shadow-sm",
        @filter != "system" &&
          "bg-white text-slate-600 border-slate-300 hover:border-blue-400 hover:text-blue-600 hover:shadow-sm"
      ]}
    >
      <.icon name="hero-server" class="size-3.5" /> Système
      <span class="opacity-70">({system_count})</span>
    </button>
    <button
      phx-click="filter"
      phx-value-filter="derived"
      class={[
        "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 border",
        @filter == "derived" && "bg-blue-600 text-white border-blue-600 shadow-sm",
        @filter != "derived" &&
          "bg-white text-slate-600 border-slate-300 hover:border-blue-400 hover:text-blue-600 hover:shadow-sm"
      ]}
    >
      <.icon name="hero-arrow-path" class="size-3.5" /> Dérivées
      <span class="opacity-70">({derived_count})</span>
    </button>
  </div>

  <%!-- Table card with all columns visible and compact widths --%>
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 animate-fade-in-up delay-2 relative">
    <div class="overflow-x-auto">
      <table class="w-full text-sm table-fixed">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="w-[10%] px-2 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Code
            </th>
            <th class="w-[24%] px-2 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Nom
            </th>
            <th class="w-[12%] px-2 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Catégorie
            </th>
            <th class="w-[10%] px-2 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Classe
            </th>
            <th class="w-[8%] px-2 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Niveau
            </th>
            <th class="w-[12%] px-2 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Moniteur
            </th>
            <th class="w-[8%] px-2 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Actif
            </th>
            <th class="w-[7%] px-2 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Orgs
            </th>
            <th class="w-[9%] px-2 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= for event <- @events do %>
            <tr class={[
              "transition-all duration-150",
              if(event.active,
                do: "hover:bg-blue-50/50",
                else: "opacity-60 hover:opacity-80 hover:bg-slate-50"
              )
            ]}>
              <td class="px-2 py-3 truncate">
                <span class="font-mono text-[11px] font-bold bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded leading-none">
                  {event.code}
                </span>
              </td>
              <td class="px-2 py-3">
                <div class="truncate">
                  <span class="text-sm font-semibold text-slate-900 truncate block leading-tight">
                    {event.name}
                  </span>
                  <p class="text-[11px] text-slate-400 truncate mt-0.5 leading-tight">
                    {event.definition || "—"}
                  </p>
                </div>
              </td>
              <td class="px-2 py-3">
                <span class={[
                  "inline-flex items-center gap-1 px-1.5 py-0.5 text-[11px] font-semibold rounded leading-none whitespace-nowrap",
                  event.category == "physical" &&
                    "bg-blue-50 text-blue-700 border border-blue-200",
                  event.category == "system" &&
                    "bg-violet-50 text-violet-700 border border-violet-200",
                  event.category == "derived" &&
                    "bg-amber-50 text-amber-700 border border-amber-200"
                ]}>
                  <.icon
                    name={
                      (event.category == "physical" && "hero-cpu-chip") ||
                        (event.category == "system" && "hero-server") || "hero-arrow-path"
                    }
                    class="size-2.5"
                  />
                  {event.category}
                </span>
              </td>
              <td class="px-2 py-3 truncate">
                <span class="text-[11px] font-medium text-slate-500">{event.class || "—"}</span>
              </td>
              <td class="px-2 py-3 text-center">
                <span class={[
                  "inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[11px] font-bold rounded leading-none whitespace-nowrap",
                  event.level == 1 && "bg-sky-50 text-sky-700 border border-sky-200",
                  event.level == 2 && "bg-amber-50 text-amber-700 border border-amber-200",
                  event.level >= 3 && "bg-rose-50 text-rose-700 border border-rose-200"
                ]}>
                  <.icon name="hero-signal" class="size-2.5" /> {event.level}
                </span>
              </td>
              <td class="px-2 py-3 truncate">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[11px] font-mono bg-slate-100 text-slate-600 rounded leading-none">
                  {event.monitor_type}
                </span>
              </td>
              <td class="px-2 py-3 text-center">
                <button
                  phx-click="toggle-active"
                  phx-value-id={event.id}
                  class={[
                    "relative inline-flex h-5 w-9 items-center rounded-full transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1",
                    if(event.active, do: "bg-blue-600", else: "bg-slate-300 hover:bg-slate-400")
                  ]}
                >
                  <span class={[
                    "inline-block size-3.5 transform rounded-full bg-white shadow-sm transition-transform duration-200",
                    if(event.active, do: "translate-x-[18px]", else: "translate-x-[3px]")
                  ]} />
                </button>
              </td>
              <td class="px-2 py-3 text-center">
                <.link
                  :if={event.org_count > 0}
                  navigate={~p"/org-events"}
                  class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 hover:shadow-sm transition-all leading-none whitespace-nowrap"
                >
                  <span class="tabular-nums">{event.org_count}</span>
                  <.icon name="hero-building-office" class="size-2.5" />
                </.link>
                <span
                  :if={event.org_count == 0}
                  class="inline-flex px-1.5 py-0.5 text-[11px] font-semibold rounded-full bg-slate-50 text-slate-400 border border-slate-200 leading-none"
                >
                  0
                </span>
              </td>
              <td class="px-2 py-3 text-right">
                <.link
                  navigate={"/global-events/#{event.id}/edit"}
                  class="inline-flex items-center gap-1 px-2 py-1 text-[11px] font-bold text-slate-600 bg-white hover:bg-blue-50 hover:text-blue-600 rounded-lg border border-slate-300 hover:border-blue-400 hover:shadow-sm transition-all leading-none whitespace-nowrap"
                >
                  <.icon name="hero-pencil" class="size-2.5" /> Modifier
                </.link>
              </td>
            </tr>
          <% end %>
          <%= if @events == [] do %>
            <tr>
              <td colspan="9">
                <div class="flex flex-col items-center justify-center py-16">
                  <div class="size-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
                    <.icon name="hero-inbox" class="size-8 text-slate-400" />
                  </div>
                  <h3 class="text-base font-bold text-slate-500">Aucune définition trouvée</h3>
                  <p class="text-sm text-slate-400 mt-1">
                    Aucun événement ne correspond au filtre sélectionné.
                  </p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%!-- Footer navigation --%>
  <div class="flex items-center justify-between pt-2 animate-fade-in-up delay-3">
    <.link
      navigate="/dashboard"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-slate-600 hover:text-blue-600 bg-white hover:bg-blue-50 rounded-lg border border-slate-300 hover:border-blue-400 transition-all duration-200"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Dashboard
    </.link>
    <.link
      navigate="/org-events"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow-md transition-all duration-200"
    >
      Config. organisations <.icon name="hero-arrow-right" class="size-4" />
    </.link>
  </div>
</div>
