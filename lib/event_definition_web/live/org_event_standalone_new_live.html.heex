<section class="space-y-6">
  <.breadcrumbs crumbs={[
    {"Accueil", "/"},
    {"Config. organisations", "/org-events"},
    {"Nouvel événement", ""}
  ]} />
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 animate-fade-in-up">
    <div class="flex items-center gap-4 mb-4">
      <div class="size-12 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center shadow-sm shrink-0">
        <.icon name="hero-sparkles" class="size-6 text-white" />
      </div>
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">
          Nouvel événement personnalisé
        </h1>
        <p class="text-sm text-gray-500 mt-0.5">
          Organisation : <span class="font-semibold text-blue-600">{@org.name}</span>
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 animate-fade-in-up delay-1">
    <div class="p-6">
      <.form
        for={@form}
        id="standalone-event-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-5"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="space-y-5">
            <div class="bg-blue-50 rounded-xl border border-blue-200 p-4">
              <div class="flex items-center gap-2 mb-3 text-xs font-semibold text-blue-600 uppercase tracking-wider">
                <.icon name="hero-information-circle" class="size-4" /> Informations générales
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <.input
                  field={@form[:code]}
                  type="text"
                  label="Code"
                  required
                  placeholder="EXCES_VITESSE"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
                />
                <.input
                  field={@form[:name]}
                  type="text"
                  label="Nom"
                  required
                  placeholder="Excès de vitesse"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
                />
              </div>

              <.input
                field={@form[:definition]}
                type="textarea"
                label="Description"
                placeholder="Détection des excès de vitesse au-dessus du seuil configuré"
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
              />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <.input
                field={@form[:category]}
                type="select"
                label="Catégorie"
                required
                prompt="Sélectionner"
                options={[
                  {"Physique", "physical"},
                  {"Système", "system"},
                  {"Dérivé", "derived"}
                ]}
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
              />
              <.input
                field={@form[:class]}
                type="select"
                label="Classe"
                required
                prompt="Sélectionner"
                options={Enum.map(@classes, &{String.capitalize(&1), &1})}
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
              />
              <.input
                field={@form[:level]}
                type="number"
                label="Niveau"
                required
                min="1"
                value="2"
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
              />
            </div>

            <.input
              field={@form[:level_group]}
              type="select"
              label="Groupe de niveau"
              prompt="Optionnel"
              options={Enum.map(@level_groups, &{String.capitalize(&1), &1})}
              class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
            />
          </div>

          <div class="space-y-5">
            <div class="bg-amber-50 rounded-xl border border-amber-200 p-5">
              <div class="flex items-center gap-2 mb-4 text-xs font-semibold text-amber-600 uppercase tracking-wider">
                <.icon name="hero-adjustments-horizontal" class="size-4" /> Règle d'occurrence
              </div>

              <.input
                field={@form[:alert_mode]}
                type="select"
                label="Mode d'alerte"
                options={[
                  {"Aucun", "none"},
                  {"Alerte", "alert"},
                  {"Rapport", "report"},
                  {"Les deux", "both"}
                ]}
                class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
              />

              <div class="mt-4">
                <label class="block text-xs font-semibold text-amber-700 mb-2">
                  Déclencheur <span class="text-red-500">*</span>
                </label>
                <select
                  name="standalone_event[trigger]"
                  class="w-full px-3.5 py-2.5 rounded-lg border-2 border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-medium text-gray-700"
                >
                  <option value="">Sélectionner un déclencheur</option>
                  <option value="speed_exceeds" selected={@trigger == "speed_exceeds"}>
                    Excès de vitesse
                  </option>
                  <option value="no_movement" selected={@trigger == "no_movement"}>
                    Absence de mouvement
                  </option>
                  <option value="geofence_enter" selected={@trigger == "geofence_enter"}>
                    Entrée dans zone
                  </option>
                  <option value="geofence_exit" selected={@trigger == "geofence_exit"}>
                    Sortie de zone
                  </option>
                  <option value="geofence_inside" selected={@trigger == "geofence_inside"}>
                    Présence dans zone
                  </option>
                  <option value="poi_near" selected={@trigger == "poi_near"}>
                    Proximité POI
                  </option>
                  <option value="poi_approaching" selected={@trigger == "poi_approaching"}>
                    Approche POI
                  </option>
                  <option value="poi_leaving" selected={@trigger == "poi_leaving"}>
                    Départ POI
                  </option>
                  <option value="fuel_drop" selected={@trigger == "fuel_drop"}>
                    Baisse carburant
                  </option>
                  <option value="min_distance" selected={@trigger == "min_distance"}>
                    Distance minimum
                  </option>
                </select>
              </div>

              <%= if @trigger != "" do %>
                <div class="mt-4 p-3 bg-white rounded-lg border border-amber-200 space-y-3">
                  <p class="text-xs font-semibold text-amber-700 uppercase tracking-wider">
                    Paramètres — {@trigger_label[@trigger]}
                  </p>
                  <%= for param <- @trigger_param_map[@trigger] do %>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">
                        {EventDefinitionWeb.OrgEventStandaloneNewLive.param_label(param)}
                      </label>
                      <%= if param == "feature_collection_id" and @feature_collections != [] do %>
                        <input
                          type="text"
                          name={"standalone_event[param_#{param}]"}
                          value={@current_params["param_#{param}"] || ""}
                          placeholder={
                            EventDefinitionWeb.OrgEventStandaloneNewLive.param_placeholder(param)
                          }
                          list="fc-suggestions"
                          class="w-full px-3 py-2 rounded-lg border border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-mono text-gray-700"
                        />
                        <datalist id="fc-suggestions">
                          <option :for={fc <- @feature_collections} value={fc} />
                        </datalist>
                      <% else %>
                        <input
                          type={EventDefinitionWeb.OrgEventStandaloneNewLive.param_type(param)}
                          name={"standalone_event[param_#{param}]"}
                          value={@current_params["param_#{param}"] || ""}
                          placeholder={
                            EventDefinitionWeb.OrgEventStandaloneNewLive.param_placeholder(param)
                          }
                          class="w-full px-3 py-2 rounded-lg border border-gray-200 bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none text-sm font-mono text-gray-700"
                        />
                      <% end %>
                      <p class="text-xs text-gray-400 mt-0.5">
                        {EventDefinitionWeb.OrgEventStandaloneNewLive.param_hint(param)}
                      </p>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <.input
                field={@form[:enabled]}
                type="checkbox"
                label="Activer immédiatement"
                class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mt-3"
              />
            </div>

            <div class="bg-blue-50 rounded-xl border border-blue-200 p-5">
              <div class="flex items-center gap-2 mb-3 text-xs font-semibold text-blue-600 uppercase tracking-wider">
                <.icon name="hero-eye" class="size-4" /> Résumé
              </div>
              <div class="space-y-1.5 text-sm text-blue-700">
                <p><span class="font-semibold">Organisation :</span> {@org.name}</p>
                <p><span class="font-semibold">Code :</span> {@form[:code].value || "—"}</p>
                <p><span class="font-semibold">Nom :</span> {@form[:name].value || "—"}</p>
                <p>
                  <span class="font-semibold">Type :</span> Standalone (sans référence globale)
                </p>
                <p><span class="font-semibold">Niveau :</span> {@form[:level].value || "—"}</p>
                <%= if @trigger != "" do %>
                  <p>
                    <span class="font-semibold">Déclencheur :</span> {@trigger_label[@trigger]}
                  </p>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
          <button
            type="submit"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-all duration-200 text-sm shadow-sm"
          >
            <.icon name="hero-check" class="size-4" /> Créer l'événement
          </button>
          <.link
            navigate={~p"/org-events"}
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-lg transition-all duration-200"
          >
            Annuler
          </.link>
        </div>
      </.form>
    </div>
  </div>
</section>
