<Layouts.auth flash={@flash}>
  <!-- Enveloppe de secours forcée : h-[65vh] + overflow-y-auto pour forcer un scroll interne à la carte blanche -->
  <div class="w-full flex flex-col justify-start max-h-[70vh] overflow-y-auto pr-1">
    <div class="mb-4 text-center">
      <p class="text-xs uppercase tracking-[0.4em] text-slate-400">Créer un compte</p>
      <h1 class="mt-1 text-xl font-bold text-slate-900">Rejoignez Event-Definition</h1>
    </div>

    <%= if error = Phoenix.Flash.get(@flash, :error) do %>
      <div class="mb-4 rounded-xl bg-red-50 border border-red-100 p-2.5 text-xs text-red-700 text-center font-medium shadow-sm">
        {error}
      </div>
    <% end %>

    <.form for={@form} id="register-form" action={~p"/register"} method="post" class="space-y-3.5">
      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
      />

      <.input
        field={@form[:password]}
        type="password"
        label="Mot de passe"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
      />

      <.input
        field={@form[:password_confirmation]}
        type="password"
        label="Confirmation du mot de passe"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
      />

      <div class="flex justify-between items-center text-xs uppercase tracking-[0.2em] text-slate-500 py-1">
        <.link
          navigate="/login"
          class="font-semibold hover:text-blue-600 transition-colors underline underline-offset-4"
        >
          Déjà un compte ?
        </.link>
      </div>

      <button
        type="submit"
        class="w-full rounded-xl bg-blue-600 py-2.5 text-sm font-semibold uppercase tracking-[0.2em] text-white shadow-md hover:bg-blue-500 transition-colors"
      >
        Créer mon compte
      </button>
    </.form>
  </div>
</Layouts.auth>
