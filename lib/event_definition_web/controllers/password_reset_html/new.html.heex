<Layouts.auth flash={@flash}>
  <div class="min-h-[calc(100vh-160px)] bg-slate-50 flex items-start justify-center px-4 pt-4 pb-8 overflow-y-auto">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl border border-slate-100">
      <div class="text-center mb-6">
        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Mot de passe oublié</p>
        <h1 class="mt-3 text-2xl font-bold text-slate-900">Récupération du compte</h1>
        <p class="mt-3 text-sm text-slate-500 leading-relaxed">
          Cette fonctionnalité sera disponible bientôt. Veuillez contacter l'administrateur pour réinitialiser votre mot de passe.
        </p>
      </div>

      <div class="mt-6">
        <.link
          navigate="/login"
          class="flex w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors"
        >
          Retour à la page de connexion
        </.link>
      </div>
    </div>
  </div>
</Layouts.auth>
